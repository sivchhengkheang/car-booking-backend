PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/car_booking
JWT_SECRET=your_jwt_secret_here

# Frontend URL
CLIENT_URL=http://localhost:3000

# Baray Payment API
BARAY_API_KEY=your_baray_api_key
BARAY_SK=your_baray_secret_key
BARAY_IV=your_baray_iv

# Redis Cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://127.0.0.1:6379

# KOOMPI Cloud Object Storage
KOOMPI_STORAGE_BASE_URL=https://api-kconsole.koompi.cloud
KOOMPI_STORAGE_API_KEY=your_koompi_bucket_api_key
